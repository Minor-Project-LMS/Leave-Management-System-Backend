DB_URL=jdbc:postgresql://your-cloud-host:5432/lms
DB_USER=your_db_user
DB_PASSWORD=your_db_password

REDIS_URL=redis://your-redis-host:6379

# JWT Secret - Generate a secure random string (use: openssl rand -base64 32)
JWT_SECRET=your-secure-jwt-secret-key-here

# Cookie Security - Options: Lax, Strict, None
COOKIE_SAME_SITE=Strict

# CORS - Add your frontend domains (comma-separated)
# Include both localhost and 127.0.0.1 for development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional: Mail Server Configuration
# AWS SES Example: email-smtp.us-east-1.amazonaws.com
# SendGrid Example: smtp.sendgrid.net
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-email-password

# Optional: Mail Server Configuration
# AWS SES Example: email-smtp.us-east-1.amazonaws.com
# SendGrid Example: smtp.sendgrid.net
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-email-password
